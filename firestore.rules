rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Fields a user may never set on their own document: admin controls, and
    // Razorpay status, which only the payments server (Admin SDK) writes.
    function adminOnly() {
      return ['role', 'compPro', 'blocked',
              'razorpaySubscriptionId', 'razorpayPlanId', 'razorpayStatus', 'razorpayUntil', 'razorpayPaidCount',
              'playPlanId', 'playState', 'playUntil', 'playPaidCount', 'playTest',
              'referralEarnings', 'referralCount', 'referralCredited', 'referralCreditedAmount',
              'referralCreditedTo', 'referralPaid', 'referralBonusEarnings', 'referralMonths',
              'referralMonth', 'referralMonthYearly', 'referralMonthBonus'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(adminOnly());

      allow update: if signedIn() && (
        // A user updates their own activity, but never their role, Pro grant, block or join date.
        // The referral code a user signed up with is fixed at sign-up.
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(adminOnly().concat(['createdAt', 'referredByCode'])))
        // An admin can grant Pro, block, or record a referral payout, nothing else.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['compPro', 'blocked', 'referralPaid']))
      );

      // Users can delete their own account record.
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Referral code → owner. Anyone may look up one exact code (to check it at sign-up);
    // nobody may list them. A user registers only their own code.
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && !request.resource.data.get('retired', false);
      // An owner can retire their old code when it's replaced by a name code. A retired code
      // takes no new friends but still pays for friends who already used it.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retired'])
        && request.resource.data.retired == true;
      allow delete: if false;
    }

    // Google Play purchase token → account it counts for: server only.
    match /playPurchases/{id} {
      allow read, write: if false;
    }

    // Referral payouts owed: written by the server, readable by admins.
    match /referrals/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Razorpay payment records: written by the server, readable by admins.
    match /payments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
